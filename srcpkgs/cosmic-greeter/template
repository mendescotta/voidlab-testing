# Template file for 'cosmic-greeter'
pkgname=cosmic-greeter
version=1.11.0
revision=1
build_style=cargo
conf_files="/etc/greetd/cosmic-greeter.toml"
configure_args="--workspace --no-default-features --features logind,networkmanager,upower"
hostmakedepends="pkg-config clang23-devel libclang23"
makedepends="libxkbcommon-devel eudev-libudev-devel pam-devel libinput-devel
 libdav1d-devel"
depends="cosmic-comp cosmic-icons elogind greetd NetworkManager upower wayland"
short_desc="Display manager and screen locker for COSMIC"
maintainer="Bella109 <belladev109@proton.me>"
license="GPL-3.0-only"
homepage="https://github.com/pop-os/cosmic-greeter"
distfiles="https://github.com/pop-os/cosmic-greeter/archive/refs/tags/epoch-${version}.tar.gz"
checksum=f31c5bac8e50ed5df75cb7d07fb8167e7835dc22b3438a48c8c1f27e7de36e48
