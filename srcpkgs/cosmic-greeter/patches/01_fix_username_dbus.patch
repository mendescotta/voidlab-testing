Why: Allow the packaged greeter account to access its system D-Bus service.
Upstream: Void-specific account name
Drop when: upstream supports a configurable greeter account.

--- a/dbus/com.system76.CosmicGreeter.conf
+++ b/dbus/com.system76.CosmicGreeter.conf
@@ -2,7 +2,7 @@
           "-//freedesktop//DTD D-BUS Bus Configuration 1.0//EN"
           "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
 <busconfig>
-    <policy group="cosmic-greeter">
+    <policy group="_cosmicgreeter">
         <allow send_destination="com.system76.CosmicGreeter"/>
         <allow receive_sender="com.system76.CosmicGreeter"/>
     </policy>
