 gtk4-update-icon-cache wayland-devel"
makedepends="exempi-devel gnome-autoar-devel gtk4-devel libexif-devel
 libgexiv2-0.16-devel libglib-devel libnotify-devel libxml2-devel
 gst-plugins-base1-devel harfbuzz-devel libadwaita-devel
 gsettings-desktop-schemas-devel"
depends="desktop-file-utils gsettings-desktop-schemas hicolor-icon-theme gvfs"
short_desc="Minimal-dependency fork of the GNOME file manager (local test build)"
maintainer="mendescotta <mendescotta@gmail.com>"
