# Template file for 'pilot'
pkgname=pilot
version=0.1.2
revision=1
build_style=cargo
hostmakedepends="pkg-config"
makedepends="gtk4-devel"
depends="polkit"
short_desc="GTK4 service manager for dinit and runit"
maintainer="mendescotta <mendescotta@gmail.com>"
license="MIT"
homepage="https://github.com/mendescotta/pilot"
distfiles="https://github.com/mendescotta/pilot/archive/refs/tags/v${version}.tar.gz"
checksum=b14d77cb0a41b35a5cb53013d2177a2bddb31562db52da72c4daa3f9a9643fb8
# Turnstile's dinit backend expects this directory to exist (see dinit-void's own identical
# /etc/dinit.d/boot.d case); make_dirs creates it via package metadata at install time instead of
# shipping it in the package itself, since xbps-src's post-install hook strips empty directories.
make_dirs="/usr/lib/dinit.d/user/boot.d 0755 root root"

do_install() {
	vbin target/${RUST_TARGET}/release/pilot
	vinstall target/${RUST_TARGET}/release/pilot-helper 755 usr/libexec

	vinstall assets/org.voidlab.Pilot.desktop 644 usr/share/applications
	vinstall assets/org.voidlab.Pilot.svg 644 usr/share/icons/hicolor/scalable/apps
	vinstall assets/org.voidlab.Pilot.policy 644 usr/share/polkit-1/actions

	vlicense LICENSE
}
