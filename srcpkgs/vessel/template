# Template file for 'vessel'
pkgname=vessel
version=0.1.3
revision=1
build_style=cargo
hostmakedepends="pkg-config"
makedepends="gtk4-devel libadwaita-devel glib-devel"
depends="polkit xbps dracut squashfs-tools xorriso mtools dosfstools e2fsprogs"
short_desc="GTK4 app that composes a Void Linux live ISO from a profile"
maintainer="mendescotta <mendescotta@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/mendescotta/vessel"
distfiles="https://github.com/mendescotta/vessel/archive/refs/tags/v${version}.tar.gz"
checksum=dde705ed3d5bbe071ee4506fbc9a2c2a0932af19e109ac6802de65918f7c5454

do_install() {
	vbin target/${RUST_TARGET}/release/vessel
	vinstall packaging/vessel-run-build 755 usr/libexec/vessel run-build
	vinstall packaging/org.voidlinux.vessel.policy 644 usr/share/polkit-1/actions
}
