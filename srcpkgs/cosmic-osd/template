# Void installs polkit's helper at /usr/lib/polkit-1/, but cosmic-osd's
# fallback (used since there's no systemd socket activation) is hardcoded
# to /usr/libexec/polkit-agent-helper-1 via option_env!, which breaks
# authentication. Point it at the real path, same pattern as GEOCLUE_AGENT
# in cosmic-settings-daemon.
export POLKIT_AGENT_HELPER_1="/usr/lib/polkit-1/polkit-agent-helper-1"

do_install() {
	just rootdir="${DESTDIR}" cargo-target-dir="target/${RUST_TARGET}" install
}
