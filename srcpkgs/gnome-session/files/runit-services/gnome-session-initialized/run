#!/bin/sh
# Upstream's gnome-session-signal-init.service calls Initialized once,
# after gnome-shell reports it is ready (systemd Type=notify). Until then
# gnome-session-service stays in its initialization phase, which is also
# the only phase that accepts mutter's Setenv(WAYLAND_DISPLAY): signalling
# earlier leaves D-Bus activated applications without a display. Without
# systemd the shell reports readiness by registering as a client
# (gnome-shell revert-remove-gsm.patch), so wait for that ClientAdded.
# dinit runs this as a scripted service; under runsv, run it only once.
exec 2>&1
[ -p supervise/control ] && sv once .
fifo="$XDG_RUNTIME_DIR/gnome-session-initialized.fifo"
rm -f "$fifo" && mkfifo -m600 "$fifo" || exit 1
gdbus monitor --session --dest org.gnome.SessionManager \
	--object-path /org/gnome/SessionManager > "$fifo" & monitor=$!
grep -q -m1 'SessionManager.ClientAdded' < "$fifo"
kill "$monitor" 2>/dev/null
rm -f "$fifo"
exec gdbus call --session --dest org.gnome.SessionManager \
	--object-path /org/gnome/SessionManager \
	--method org.gnome.SessionManager.Initialized
