Why: Forward GNOME's late session environment updates to Turnstile's per-user Dinit.
Upstream: https://gitlab.gnome.org/GNOME/gnome-session
Drop when: upstream supports non-systemd user service managers.

--- a/gnome-session/gsm-util.c
+++ b/gnome-session/gsm-util.c
@@ -363,2 +363,30 @@ gsm_util_update_user_environment (const char  *variable,
         GError          *bus_error = NULL;
 
+        if (g_file_test ("/etc/gnome-session/dinit", G_FILE_TEST_EXISTS)) {
+                g_autofree char *entry = NULL;
+                char *argv[6];
+                int wait_status;
+
+                if (value != NULL) {
+                        entry = g_strdup_printf ("%s=%s", variable, value);
+                        argv[0] = "dinitctl";
+                        argv[1] = "--user";
+                        argv[2] = "--quiet";
+                        argv[3] = "setenv";
+                        argv[4] = entry;
+                        argv[5] = NULL;
+                } else {
+                        argv[0] = "dinitctl";
+                        argv[1] = "--user";
+                        argv[2] = "--quiet";
+                        argv[3] = "unsetenv";
+                        argv[4] = (char *) variable;
+                        argv[5] = NULL;
+                }
+
+                if (!g_spawn_sync (NULL, argv, NULL, G_SPAWN_SEARCH_PATH,
+                                   NULL, NULL, NULL, NULL, &wait_status, error))
+                        return FALSE;
+                return g_spawn_check_wait_status (wait_status, error);
+        }
+
