# Template file for 'gnome-session'
pkgname=gnome-session
version=51.0
revision=16
build_style=meson
configure_args="-Dsystemd=false -Dsystemduserunitdir=/usr/lib/systemd/user"
hostmakedepends="glib-devel gettext pkg-config xmlto"
makedepends="elogind-devel gnome-desktop-devel gtk+3-devel json-glib-devel
 libglib-devel libICE-devel libSM-devel xtrans"
depends="dbus dconf desktop-file-utils bash glib gsettings-desktop-schemas
 hicolor-icon-theme polkit gnome-settings-daemon"
short_desc="GNOME session management utilities"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GPL-2.0-or-later, LGPL-2.1-or-later"
homepage="https://gitlab.gnome.org/GNOME/gnome-session"
changelog="https://gitlab.gnome.org/GNOME/gnome-session/-/raw/main/NEWS"
distfiles="${GNOME_SITE}/gnome-session/${version%%.*}/gnome-session-${version}.tar.xz"
checksum=5195c4f60542a953ab6ebd288f3785b8e7746292d8c167e0c99d353438a184d1

post_install() {
	# gnome-session execs this once the session environment is exported;
	# upstream ships a systemd-only one (see 01-systemd-optional.patch).
	vinstall ${FILESDIR}/gnome-session-init-worker 755 usr/libexec
	vinstall ${FILESDIR}/dbus-run-session-if-needed 755 usr/libexec/gnome-session
	vsed -i "${DESTDIR}/usr/share/wayland-sessions/gnome.desktop" \
		-e 's|^Exec=|Exec=/usr/libexec/gnome-session/dbus-run-session-if-needed |'
	# Per-session component lists (sessions without one run everything).
	vinstall ${FILESDIR}/sessions/gnome-login 644 usr/libexec/gnome-session/sessions
}
