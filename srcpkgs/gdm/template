# Template file for 'gdm'
pkgname=gdm
version=51.1
revision=2
build_helper="gir"
build_style=meson
configure_args="
 -Ddefault-pam-config=arch -Dat-spi-registryd-dir=/usr/libexec
 -Dplymouth=enabled -Dpid-file=/run/gdm/gdm.pid
 -Dsystemd-journal=false -Dinitial-vt=7 $(vopt_bool x11 x11-support)
 -Dselinux=disabled -Dlibaudit=disabled $(vopt_bool x11 gdm-xsession)
 -Ddefault-path=/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/sbin:/sbin:/bin
 -Dsystemdsystemunitdir=/usr/lib/systemd/system
 -Dsystemduserunitdir=/usr/lib/systemd/user
 -Dlogind-provider=elogind -Dpam-services-dir=/etc/pam.d"
hostmakedepends="dconf gettext itstool pkg-config"
# sd_session_get_username() needs the overlay elogind (257); Void ships 252.
makedepends="accountsservice-devel elogind-devel gettext-devel glib-devel
 iso-codes libSM-devel libcanberra-devel nss-devel pam-devel upower-devel
 plymouth-devel libgudev-devel polkit-devel"
# gnome-shell depends on libgdm, so gnome-shell and gnome-session are
# pulled in through the gdm-session subpackage to avoid a build-time cycle.
depends="gdm-session>=${version}_${revision} gnome-settings-daemon gsettings-desktop-schemas
 $(vopt_if x11 'xorg-server xorg-server-xwayland xrdb')"
checkdepends="check-devel"
short_desc="GNOME Display Manager"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GPL-2.0-or-later"
homepage="https://wiki.gnome.org/Projects/GDM"
# FIXME: dead link
#changelog="https://gitlab.gnome.org/GNOME/gdm/-/raw/gnome-48/NEWS"
changelog="https://gitlab.gnome.org/GNOME/gdm/-/raw/main/NEWS"
distfiles="${GNOME_SITE}/gdm/${version%%.*}/gdm-${version}.tar.xz"
checksum=27970ad4f58eb0a48fb01bffb89a8f472503641c3573eb6d788ad4042de01120

conf_files="
	/etc/gdm/custom.conf
	/etc/dconf/profile/gdm
	/etc/pam.d/gdm-autologin
	/etc/pam.d/gdm-fingerprint
	/etc/pam.d/gdm-launch-environment
	/etc/pam.d/gdm-password
	/etc/pam.d/gdm-smartcard"
make_dirs="
	/usr/share/gdm/env.d 0755 root root
	/etc/gdm/env.d 0755 root root"
# Create the 'gdm' system user/group.
# The greeter runs as 'gdm-greeter': gdm 49+ allocates it through systemd
# userdb, and without userdb (elogind) falls back to a preallocated account
# of that exact name. xbps-src's system_accounts can't create names with a
# dash (they become shell variable names), so INSTALL creates it.
system_accounts="gdm"
gdm_homedir="/var/lib/gdm"

# Package build options
build_options="gir x11"
build_options_default="gir x11"

if [ "$CROSS_BUILD" ]; then
	hostmakedepends+=" glib-devel pam-devel"
fi

post_install() {
	# Upstream lists both modules (each "-" optional); converting the
	# pam_systemd line would register the elogind session twice.
	for f in $DESTDIR/etc/pam.d/*; do
		if grep -q "pam_elogind.so" "$f"; then
			vsed -i "/pam_systemd\.so/d" "$f"
		elif grep -q "pam_systemd.so" "$f"; then
			vsed -i "s/pam_systemd\.so/pam_elogind.so/" "$f"
		fi
	done

	# Use the shipped greeter defaults without requiring an administrator
	# to create a compiled /etc/dconf/db/gdm database.
	vmkdir etc/dconf/profile
	cat > "${DESTDIR}/etc/dconf/profile/gdm" <<-EOF
		user-db:user
		file-db:/usr/share/gdm/greeter-dconf-defaults
	EOF

	# runit service
	vsv gdm
}

gdm-session_package() {
	metapackage=yes
	depends="gnome-shell gnome-session"
	short_desc+=" - session dependencies"
}

libgdm_package() {
	short_desc+=" - runtime libraries"
	pkg_install() {
		vmove "usr/lib/*.so.*"
		# gnome-shell reads org.gnome.login-screen even without gdm
		vmove usr/share/glib-2.0/schemas/org.gnome.login-screen.gschema.xml
		if [ "$build_option_gir" ]; then
			vmove usr/lib/girepository-1.0
		fi
	}
}

gdm-devel_package() {
	depends="libgdm>=${version}_${revision} elogind-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		if [ "$build_option_gir" ]; then
			vmove usr/share/gir-1.0
		fi
		vmove "usr/lib/*.so"
	}
}
